# Copia este archivo a ".env" y ajusta los valores según tu entorno.

# Puerto en el que corre el servidor Express
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cadena de conexión a PostgreSQL (Prisma la lee desde aquí)
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raysafe