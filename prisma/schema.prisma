// Schema de Prisma: define los modelos de la base de datos (la "fuente de verdad").
// `npx prisma migrate dev --name iniciar` genera las tablas en PostgreSQL.
// `npx prisma studio` abre una interfaz visual para ver los datos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Lee la URL desde el archivo .env
}

// Ejemplo de modelo (lo usaremos de base para tu API real).
// La tabla "User" se crea automáticamente al hacer la primera migración.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}